# Copy to .env and fill in. Never commit .env.
# Elasticsearch endpoint of your project (Serverless: Project settings > Connection details)
ES_URL=https://<project>.es.<region>.elastic.cloud:443
# Kibana endpoint. On Serverless it is usually the ES URL with ".es." replaced by ".kb."
KIBANA_URL=https://<project>.kb.<region>.elastic.cloud:443
# API key (base64 "encoded" value)
ES_API_KEY=<base64 api key>

# ---- optional ----
# LLM used for query understanding and by the agent. List options: python3 setup.py --models
# If unset, setup.py picks a fast one and writes it here.
# LLM_INFERENCE_ID=
# Set to empty if your model rejects it
# LLM_REASONING_LEVEL=none
# EMBED_INFERENCE_ID=.jina-embeddings-v5-text-small
# RERANK_INFERENCE_ID=.jina-reranker-v3
# PORT=8080
